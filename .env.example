# ---------------------------------------------------------------
# OpenDive Atlas environment variables
# Copy to .env.local for local development. See docs/ENVIRONMENT.md.
# ---------------------------------------------------------------

# Supabase project API URL (Project Settings -> API, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable / anon key. Safe to expose to the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of this deployment, used for auth redirect links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI features (server-only, see docs/ENVIRONMENT.md#ai-features).
# ANTHROPIC_API_KEY turns on "Find my dive" recommendations; with AI_REVIEW_TOKEN
# (must match public.maintenance_tokens job 'ai-review') it also turns on the AI moderator.
ANTHROPIC_API_KEY=
AI_REVIEW_TOKEN=
# Or keyless, via workload identity federation on Vercel (preferred over a key):
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
